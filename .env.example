# Gemini API Key 설정 (Google AI Studio에서 발급: https://aistudio.google.com)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 수업용 접속 비밀번호 (원하는 임의의 4자리 숫자로 설정하세요)
SITE_PASSWORD=1234

# 세션 서명용 비밀키 (임의의 무작위 문자열)
SECRET_KEY=change-this-to-a-secure-random-key

# Gemini 모델명 (기본값: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
